# Copy this file to backend/.env and adjust as needed.
# See README.md for a full explanation of each variable.

# --- Database ---------------------------------------------------------------
# Leave empty to use the local SQLite fallback (backend/game_count.db).
# Set to a Postgres/Supabase connection string to use a real database.
DATABASE_URL=

# --- Supabase (optional, only if using Supabase for DB/storage) ------------
SUPABASE_URL=
SUPABASE_KEY=

# --- AI model -----------------------------------------------------------
# Path to a trained YOLO .pt file. Only required when DEMO_MODE=false.
MODEL_PATH=

# --- Demo mode ----------------------------------------------------------
# true  = use the built-in DemoDetector (simulated results, no model needed)
# false = use a real YOLO model at MODEL_PATH
DEMO_MODE=true

# --- Uploads --------------------------------------------------------------
MAX_IMAGE_SIZE_MB=20
